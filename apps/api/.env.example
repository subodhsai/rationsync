# apps/api — Express API (Render). Copy to apps/api/.env for local development.
# Never commit the real .env. On Render, set these in the service's Environment tab.

# Render sets PORT itself. Local default is 4000.
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Supabase project URL: Project Settings > API > Project URL
SUPABASE_URL=

# Postgres connection string, server-only. Supabase dashboard > Connect > Session pooler.
# Contains the database password: keep it out of the browser, the repo and logs.
DATABASE_URL=

# Optional: Supabase's CA certificate (PEM contents) to verify the database server.
# Download it from Project Settings > Database > SSL Configuration.
DATABASE_CA_CERT=

# Optional: only for projects still on the legacy shared JWT secret (HS256).
# New projects sign sessions with asymmetric keys and need nothing here.
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
