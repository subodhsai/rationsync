# apps/web — Next.js frontend (Vercel). Copy to apps/web/.env.local for local development.
# Every NEXT_PUBLIC_ value is shipped to the browser. Never put a secret here.

# Base URL of the Express API (Render in production).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Leave both empty to run in preview mode with fictional demo data.
# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
